# Copy to .env and replace placeholders. Never commit real values.
# Every variable is documented in docs/environment.md (a test keeps the two in sync).
# Real environment variables win over this file. Startup fails with a list of any missing
# or invalid variable (see config/env_validation.py).
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=YOUR_SECRET_KEY
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: frontend origins the browser may call /api/ from. Comma-separated scheme://host[:port],
# no wildcard, no trailing slash. Defaults to the local dev frontend; REQUIRED in production.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_PREFLIGHT_MAX_AGE=600
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# DRF (optional)
API_PAGE_SIZE=25
API_THROTTLE_ANON=100/hour
API_THROTTLE_USER=1000/hour

# OpenAPI schema + Swagger UI / ReDoc at /api/v1/{schema,docs,redoc}/ (optional; on in dev, off elsewhere)
# API_DOCS_ENABLED=true

# Auth (optional, defaults shown)
# JWT_ACCESS_LIFETIME_MINUTES=15
# JWT_REFRESH_LIFETIME_DAYS=7
# API_THROTTLE_LOGIN=20/min
# API_THROTTLE_LOGIN_EMAIL=5/min
# AUTH_REFRESH_COOKIE_ENABLED=false
# AUTH_REFRESH_COOKIE_SECURE=true
# AUTH_REFRESH_COOKIE_NAME=abm_refresh
# AUTH_REFRESH_COOKIE_SAMESITE=Lax

# Logging (optional)
# LOG_LEVEL=INFO

# Background worker, Django-Q2 (optional)
# Q_WORKERS=2
# Q_TASK_TIMEOUT=300
# Q_TASK_RETRY=360

# Dev superuser, read by `manage.py seed_dev_data` only (optional; no password, no superuser)
# DEV_SUPERUSER_EMAIL=YOUR_EMAIL
# DEV_SUPERUSER_PASSWORD=YOUR_DEV_ADMIN_PASSWORD
# DEV_SEED_USER_PASSWORD=YOUR_DEV_SEED_PASSWORD

# Production only
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN

# Reserved for later issues: provider credentials. NOT read by any code yet.
# When they are, they stay in the environment / secret store, are encrypted at rest if
# persisted, and are never logged (docs/environment.md, "Secrets handling").
# LLM_API_KEY=YOUR_LLM_API_KEY
# DATA_PROVIDER_API_KEY=YOUR_DATA_PROVIDER_API_KEY
# CRM_API_KEY=YOUR_CRM_API_KEY
