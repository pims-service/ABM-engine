# Copy to .env next to docker-compose.prod.yml on the server and replace every YOUR_* value.
# Never commit the real file. Generate the secrets on the server and keep them there.

# The tag of the images that were built or loaded (for example a short git commit hash).
IMAGE_TAG=YOUR_IMAGE_TAG
# The host name or IP address people open in the browser. Caddy gets the certificate for it.
PUBLIC_HOST=YOUR_PUBLIC_HOST

POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=YOUR_DB_NAME

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=YOUR_SECRET_KEY
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEYS=YOUR_INTEGRATION_ENCRYPTION_KEYS
