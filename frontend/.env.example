# Copy to .env.local. Documented in docs/environment.md (a test keeps the two in sync).
# Base URL of the backend API (Django/DRF). Inlined at build time and sent to browsers:
# NEXT_PUBLIC_* values are public, so never put a secret in one.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Server-only address of the API for the auth route handlers (/api/auth/*). Optional: defaults to
# NEXT_PUBLIC_API_BASE_URL. Set it when the server reaches the API at another address than browsers do.
# API_INTERNAL_BASE_URL=http://localhost:8000/api
