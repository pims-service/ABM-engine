# Copy to .env and replace the placeholders. Never commit real values.
# Used by docker-compose.yml. .env is git-ignored.
# Every variable is documented in docs/environment.md (a test keeps the two in sync).

# --- PostgreSQL (db service) ---
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=YOUR_DB_NAME

# --- Django (api and worker services) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=YOUR_SECRET_KEY
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Logging (optional) ---
# LOG_LEVEL=INFO
# Extra comma-separated field names to redact from logs (defaults already cover passwords, tokens, keys).

# --- Background worker (optional) ---
# Q_WORKERS=2
# Q_TASK_TIMEOUT=300
# Q_TASK_RETRY=360

# --- Dev superuser, read by `manage.py seed_dev_data` only (optional) ---
# Without a password no superuser is created. Dev only; never use a real password.
# DEV_SUPERUSER_USERNAME=admin
# DEV_SUPERUSER_EMAIL=YOUR_EMAIL
# DEV_SUPERUSER_PASSWORD=YOUR_DEV_ADMIN_PASSWORD

# --- Next.js (web service) ---
# Address of the API as seen from the BROWSER (host port of the api service).
# Public: this value is shipped to browsers, so never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Host ports (change only if the defaults are already in use) ---
# If you change API_PORT, update NEXT_PUBLIC_API_BASE_URL to match.
# DB_PORT=5432
# API_PORT=8000
# WEB_PORT=3000
